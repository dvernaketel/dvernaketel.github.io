---
interface GalleryImage {
  file: string;
  title: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  images: readonly GalleryImage[];
  imagePath: string;
}

const { images, imagePath } = Astro.props;
---

<section class="project-gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="project-section-heading">
    <h2 id="gallery-title">Gallery</h2>
    <div class="gallery-controls" data-gallery-controls hidden>
      <button type="button" aria-controls="gallery-images" data-previous disabled>Previous</button>
      <span class="gallery-count" data-gallery-count aria-live="polite">1 / {images.length}</span>
      <button type="button" aria-controls="gallery-images" data-next>Next</button>
    </div>
  </div>
  <ol class="gallery-track" id="gallery-images" aria-label="Project images" role="list" tabindex="0">
    {images.map(({ file, title, alt, width, height }) => {
      const url = `${imagePath}/${file}`;
      return (
        <li class="gallery-slide">
          <figure>
            <div class="gallery-frame">
              <img src={url} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
            </div>
            <figcaption>
              <span>{title}</span>
              <a class="text-link" href={url} target="_blank" rel="noopener">
                Full image<span class="sr-only"> of {title} (opens in a new tab)</span>
              </a>
            </figcaption>
          </figure>
        </li>
      );
    })}
  </ol>
</section>

<script>
  const track = document.querySelector<HTMLOListElement>('#gallery-images');
  const controls = document.querySelector<HTMLElement>('[data-gallery-controls]');

  if (track && controls) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.gallery-slide'));
    const previous = controls.querySelector<HTMLButtonElement>('[data-previous]');
    const next = controls.querySelector<HTMLButtonElement>('[data-next]');
    const count = controls.querySelector<HTMLElement>('[data-gallery-count]');

    if (slides.length > 1 && previous && next && count) {
      let index = 0;
      const last = slides.length - 1;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const update = () => {
        const step = slides[1].offsetLeft - slides[0].offsetLeft;
        if (step <= 0) return;

        index = Math.max(0, Math.min(last, Math.round(track.scrollLeft / step)));
        previous.disabled = index === 0;
        next.disabled = index === last;
        const position = `${index + 1} / ${slides.length}`;
        if (count.textContent !== position) count.textContent = position;
      };

      const move = (to: number) => {
        const slide = slides[Math.max(0, Math.min(last, to))];
        track.scrollTo({ left: slide.offsetLeft, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
      };

      previous.addEventListener('click', () => move(index - 1));
      next.addEventListener('click', () => move(index + 1));
      track.addEventListener('scroll', update, { passive: true });
      track.addEventListener('keydown', (event) => {
        if (event.target !== track || event.altKey || event.ctrlKey || event.metaKey) return;

        const destinations = { ArrowLeft: index - 1, ArrowRight: index + 1, Home: 0, End: last };
        if (Object.hasOwn(destinations, event.key)) {
          event.preventDefault();
          move(destinations[event.key as keyof typeof destinations]);
        }
      });

      controls.hidden = false;
      update();
    }
  }
</script>
