---
import '../styles/portfolio.css';

interface Props {
  title?: string;
  description: string;
  section: 'work' | 'about';
}

const { title, description, section } = Astro.props;
const name = 'Dominic Verna-Ketel';
const pageTitle = title ? `${title} · ${name}` : `${name} · Engineering Portfolio`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafbfc" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={`${base}/`}>
          <span class="brand-mark" aria-hidden="true">DV</span>
          <span>{name}</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={`${base}/#work`} data-active={section === 'work' ? '' : undefined}>Work</a>
          <a href={`${base}/about/`} aria-current={section === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="footer-name" href={`${base}/`}>{name}</a>
        <nav aria-label="Footer navigation">
          <a href={`${base}/#work`}>Work</a>
          <a href={`${base}/about/`}>About</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
