---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import { robotArm } from '../data/robot-arm';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const render = `${base}/images/robot-arm/robot-arm-cad-render.webp`;
const projectPath = `${base}/projects/robot-arm/`;
---

<PortfolioLayout
  description="Engineering portfolio of Dominic Verna-Ketel, featuring a three-axis robotic arm designed, built, and tested in six weeks."
  section="work"
>
  <div class="shell">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <h1 id="home-title" class="display-title">Engineering<br />in motion.</h1>
        <p class="page-lead">Mechanical design, prototyping, and motion control.</p>
        <a class="button" href="#work">View work</a>
      </div>

      <figure class="hero-plate">
        <img
          src={render}
          alt="CAD render of the three-axis robotic arm"
          width="1040"
          height="1039"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="work-section" id="work" aria-labelledby="work-title">
      <h2 id="work-title" class="section-title">Work</h2>
      <article class="work-card">
        <div class="work-image">
          <img
            src={render}
            alt=""
            width="1040"
            height="1039"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="work-copy">
          <p class="project-meta">{robotArm.type} · {robotArm.year}</p>
          <h3>{robotArm.title}</h3>
          <p class="work-summary">A tabletop robot built and tested in six weeks.</p>
          <a class="text-link" href={projectPath}>View project<span class="sr-only"> · 3-axis robotic arm</span></a>
          <details class="disclosure work-highlights">
            <summary>Highlights</summary>
            <div class="disclosure-body">
              <dl class="work-stats">
                {robotArm.highlights.map(({ value, label }) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </details>
        </div>
      </article>
    </section>
  </div>
</PortfolioLayout>
