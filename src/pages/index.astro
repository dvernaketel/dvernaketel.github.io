---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import { robotArm } from '../data/robot-arm';
import { physicsSandbox } from '../data/physics-sandbox';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const render = `${base}/images/robot-arm/robot-arm-cad-render.webp`;
const flightPlot = physicsSandbox.studies[0];

const projects = [
  {
    title: robotArm.title,
    type: robotArm.type,
    year: robotArm.year,
    summary: 'A tabletop robot built and tested in six weeks.',
    link: `${base}/projects/robot-arm/`,
    thumbnail: { src: render, alt: '', width: 1040, height: 1039 },
    highlights: robotArm.highlights,
  },
  {
    title: physicsSandbox.title,
    type: physicsSandbox.type,
    year: physicsSandbox.year,
    summary: physicsSandbox.summary,
    link: `${base}/projects/physics-sandbox/`,
    thumbnail: {
      src: `${base}/images/physics-sandbox/${flightPlot.file}`,
      alt: flightPlot.alt,
      width: 1440,
      height: 864,
    },
  },
];
---

<PortfolioLayout
  description="Engineering portfolio of Dominic Verna-Ketel, featuring work in mechanical design, mechatronics, and numerical simulation."
  section="work"
>
  <div class="shell">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <h1 id="home-title" class="display-title">Engineering<br />in motion.</h1>
        <p class="page-lead">Mechanical design, prototyping, and motion control.</p>
        <a class="button" href="#work">View work</a>
      </div>

      <figure class="hero-plate">
        <img
          src={render}
          alt="CAD render of the three-axis robotic arm"
          width="1040"
          height="1039"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="work-section" id="work" aria-labelledby="work-title">
      <h2 id="work-title" class="section-title">Work</h2>
      {projects.map(({ title, type, year, summary, link, thumbnail, highlights }) => (
        <article class="work-card">
          <div class="work-image">
            <img {...thumbnail} loading="lazy" decoding="async" />
          </div>
          <div class="work-copy">
            <p class="project-meta">{type} · {year}</p>
            <h3>{title}</h3>
            <p class="work-summary">{summary}</p>
            <a class="text-link" href={link}>View project<span class="sr-only"> · {title}</span></a>
            {highlights && (
              <details class="disclosure work-highlights">
                <summary>Highlights</summary>
                <div class="disclosure-body">
                  <dl class="work-stats">
                    {highlights.map(({ value, label }) => (
                      <div>
                        <dt>{label}</dt>
                        <dd>{value}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </details>
            )}
          </div>
        </article>
      ))}
    </section>
  </div>
</PortfolioLayout>
