---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const practice = [
  {
    title: 'Mechanical design',
    description: 'CAD, motor sizing, belt drives, and bearing layouts.',
  },
  {
    title: 'Controls',
    description: 'Python pose commands and ESP32 firmware for stepper motion.',
  },
  {
    title: 'Prototyping',
    description: '3D-printed assemblies, bench tests, and performance measurements.',
  },
];
---

<PortfolioLayout
  title="About"
  description="Dominic Verna-Ketel designs, builds, and tests mechanical systems."
  section="about"
>
  <div class="shell">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-copy">
        <h1 id="about-title" class="page-title">Dominic<br />Verna-Ketel</h1>
        <p class="page-lead">I build mechanical systems that move, from early CAD to working prototypes.</p>
        <a class="text-link" href={`${base}/projects/robot-arm/`}>View the robotic arm project</a>
      </div>
      <figure class="about-figure">
        <img
          src={`${base}/images/robot-arm/robot-arm-early-joint-prototype.webp`}
          alt="Early 3D-printed joint hardware on a worktable"
          width="900"
          height="1200"
          fetchpriority="high"
        />
        <figcaption>Early joint prototype</figcaption>
      </figure>
    </section>
    <section class="practice-section" aria-labelledby="practice-title">
      <h2 id="practice-title" class="section-title">Skills</h2>
      <div class="disclosure-list">
        {practice.map(({ title, description }) => (
          <details class="disclosure">
            <summary>{title}</summary>
            <div class="disclosure-body"><p>{description}</p></div>
          </details>
        ))}
      </div>
    </section>
  </div>
</PortfolioLayout>
