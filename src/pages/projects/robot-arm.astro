---
import ProjectTimeline from '../../components/ProjectTimeline.astro';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { robotArm } from '../../data/robot-arm';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imagePath = `${base}/images/robot-arm`;
const videoPath = `${base}/videos/robot-arm-timeline`;
---

<PortfolioLayout title={robotArm.title} description={robotArm.summary} section="work">
  <article class="shell case-study">
    <header class="case-header">
      <a class="text-link back-link" href={`${base}/#work`}>All work</a>
      <h1 class="page-title">{robotArm.title}</h1>
      <p class="page-lead">From CAD to a working tabletop arm in six weeks.</p>
      <nav class="case-shortcuts" aria-label="On this page">
        <a class="text-link" href="#timeline">Timeline</a>
        <a class="text-link" href="#gallery">Build</a>
        <a class="text-link" href="#results">Results</a>
      </nav>
    </header>

    <figure class="case-hero">
      <video
        controls
        playsinline
        preload="metadata"
        poster={`${imagePath}/robot-arm-completed-prototype.webp`}
        width="1920"
        height="1080"
        aria-label="Three-axis robotic arm demonstration"
      >
        <source src={`${videoPath}.webm`} type={'video/webm; codecs="vp9, opus"'} />
        <source src={`${videoPath}.mp4`} type="video/mp4" />
        <a href={`${videoPath}.mp4`}>Download the robotic arm demonstration</a>
      </video>
      <figcaption class="case-video-caption">
        <span>Prototype demo · 1:16</span>
        <a href={`${videoPath}.mp4`} target="_blank" rel="noopener">
          Open video<span class="sr-only"> in a new tab</span>
        </a>
      </figcaption>
    </figure>

    <section class="project-timeline" id="timeline" aria-labelledby="timeline-title">
      <div class="project-section-heading"><h2 id="timeline-title">Timeline</h2></div>
      <ProjectTimeline steps={robotArm.timeline} />
    </section>

    <section class="project-build" id="gallery" aria-labelledby="build-title">
      <div class="project-section-heading"><h2 id="build-title">Build</h2></div>
      <ol class="build-entries" id="details" role="list">
        {robotArm.buildImages.map(({ file, title, alt, width, height, format, description, section }) => {
          const url = `${imagePath}/${file}`;
          return (
            <li class="build-entry">
              <img
                class:list={['build-image', { 'build-photo': format === 'photo', 'build-portrait': height > width }]}
                src={url}
                alt={alt}
                width={width}
                height={height}
                loading="lazy"
                decoding="async"
              />
              <details class="disclosure">
                <summary>{title}</summary>
                <div class="disclosure-body" id={section}>
                  <p>{description}</p>
                  {section === 'controls' && (
                    <ol class="control-flow" aria-label="Motion control signal path">
                      <li><strong>Python</strong><span>Pose commands</span></li>
                      <li><strong>ESP32</strong><span>Trajectory planning</span></li>
                      <li><strong>DM542T</strong><span>Motor drive</span></li>
                    </ol>
                  )}
                  <a class="text-link" href={url} target="_blank" rel="noopener">
                    Full image<span class="sr-only"> of {title} (opens in a new tab)</span>
                  </a>
                </div>
              </details>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="disclosure-list project-results" aria-label="Project results">
      <details class="disclosure">
        <summary>Test results</summary>
        <div class="disclosure-body" id="results">
          <table class="results-table">
            <caption class="sr-only">Design targets and observed prototype results</caption>
            <thead>
              <tr><th scope="col">Metric</th><th scope="col">Target</th><th scope="col">Result</th></tr>
            </thead>
            <tbody>
              {robotArm.results.map(({ metric, target, result, note }) => (
                <tr>
                  <th scope="row">{metric}</th>
                  <td>{target}</td>
                  <td><strong>{result}</strong>{note && <span class="result-note">{note}</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <h3>Next iteration</h3>
          <p>
            Belt slip limited payload, and the base housing flexed. The next build would improve tensioning, test a crossed-roller base bearing, and measure repeatability at more poses and axes.
          </p>
        </div>
      </details>
    </section>
  </article>
</PortfolioLayout>
