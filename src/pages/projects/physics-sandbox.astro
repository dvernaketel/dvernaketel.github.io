---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { physicsSandbox } from '../../data/physics-sandbox';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imagePath = `${base}/images/physics-sandbox`;
---

<PortfolioLayout title={physicsSandbox.title} description={physicsSandbox.summary} section="work">
  <article class="shell case-study">
    <header class="case-header">
      <a class="text-link back-link" href={`${base}/#work`}>All work</a>
      <h1 class="page-title">{physicsSandbox.title}</h1>
      <p class="page-lead">A Python sandbox for modeling motion and checking numerical solvers against known solutions.</p>
      <nav class="case-shortcuts" aria-label="On this page">
        <a class="text-link" href="#flight">Flight</a>
        <a class="text-link" href="#spin">Spin</a>
        <a class="text-link" href="#convergence">Convergence</a>
        <a class="text-link" href="#oscillator">Oscillator</a>
      </nav>
    </header>

    <div class="physics-studies">
      {physicsSandbox.studies.map(({ id, title, file, alt, caption, disclosure, notes }, index) => (
        <section class="physics-study" id={id} aria-labelledby={`${id}-title`}>
          <div class="project-section-heading"><h2 id={`${id}-title`}>{title}</h2></div>
          <figure>
            <img
              class="build-image"
              src={`${imagePath}/${file}`}
              alt={alt}
              width="1440"
              height="864"
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
              decoding="async"
            />
            <figcaption>{caption}</figcaption>
          </figure>
          <details class="disclosure">
            <summary>{disclosure}</summary>
            <div class="disclosure-body">
              {notes.map(note => <p>{note}</p>)}
              <a class="text-link" href={`${imagePath}/${file}`} target="_blank" rel="noopener">
                Full plot<span class="sr-only"> of {title} (opens in a new tab)</span>
              </a>
            </div>
          </details>
        </section>
      ))}
    </div>
  </article>
</PortfolioLayout>
